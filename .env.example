# ─── Database (Postgres via docker-compose) ─────────────────────────────
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_dev_password
POSTGRES_DB=ecom_shop
POSTGRES_PORT=5432
DATABASE_URL="postgresql://ecom:ecom_dev_password@localhost:5432/ecom_shop?schema=public"

# ─── Redis (cache + BullMQ queues) ──────────────────────────────────────
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ─── API ────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development

# ─── Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Storefront (SSR) ───────────────────────────────────────────────────
STOREFRONT_PORT=4200
STOREFRONT_API_URL=http://localhost:3000
STOREFRONT_PUBLIC_URL=http://localhost:4200

# ─── Admin (CSR) ────────────────────────────────────────────────────────
ADMIN_PORT=4300
ADMIN_API_URL=http://localhost:3000

# ─── Media (Phase 4 — S3 real integration; stubbed for now) ─────────────
S3_REGION=ap-south-1
S3_BUCKET=ecom-shop-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=

# ─── Payments (Phase 3) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# ─── Messaging (Phase 3) ────────────────────────────────────────────────
RESEND_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ECOMSHP
MSG91_OTP_TEMPLATE_ID=
